# Everything the build does not need. This file is not a tidiness preference:
# without it the whole working tree goes to the daemon as build context, which
# means .env and dev.sqlite reach the build and node_modules is uploaded only
# to be discarded by `npm ci`.

.git
.gitignore
.github

node_modules
dist
coverage

.env
.env.*
!.env.example

*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Anchored, for the same reason the .gitignore entry is: this names the one
# directory the disk driver writes into, not every directory called `storage`.
# Its unanchored twin in .gitignore kept src/storage/ out of the repository.
/storage/

.agents
wiki
README.md
LICENSE

test
vitest.config.ts

Dockerfile
.dockerignore

# Copy to .env and fill in. Every key here is validated at startup by
# src/config.ts; a missing or malformed value fails the process immediately
# rather than surfacing at the first request that needs it.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# sqlite | postgresql | mysql | mariadb
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.sqlite

# At least 32 characters. Signs access tokens only -- refresh tokens are random
# and are stored as digests, not signed.
JWT_SECRET=change-me-to-at-least-thirty-two-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

STORAGE_DIR=./storage
PANEL_ORIGIN=http://localhost:5173

# A demo account, so an evaluation needs no registration. OFF by default, and
# read wiki/environments/env.md before turning it on: it is a real account, and
# anyone who can reach the panel can publish artifacts as it.
DEMO_ACCOUNT_ENABLED=false
# DEMO_ACCOUNT_HANDLE=demo
# DEMO_ACCOUNT_EMAIL=demo@mcengine.local
# DEMO_ACCOUNT_PASSWORD=demo-password-1234
